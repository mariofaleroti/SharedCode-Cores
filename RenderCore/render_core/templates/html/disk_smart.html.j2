<!doctype html>
<html lang="es" data-theme="{{ theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ document.title }}</title>
  <style>
    :root {
      --bg-0: #06101f;
      --bg-1: #0b1220;
      --bg-2: #101827;
      --panel: rgba(15,23,42,.86);
      --panel-solid: #111827;
      --panel-soft: rgba(30,41,59,.74);
      --surface: rgba(255,255,255,.055);
      --surface-strong: rgba(255,255,255,.09);
      --text: #e5e7eb;
      --text-strong: #ffffff;
      --muted: #9ca3af;
      --muted-2: #64748b;
      --border: rgba(148,163,184,.20);
      --border-strong: rgba(148,163,184,.34);
      --accent: #38bdf8;
      --accent-2: #22c55e;
      --violet: #a78bfa;
      --ok: #22c55e;
      --warning: #f59e0b;
      --critical: #ef4444;
      --info: #38bdf8;
      --shadow: rgba(0,0,0,.38);
      --radius-lg: 26px;
      --radius-md: 18px;
      --radius-sm: 12px;
    }

    html[data-theme="light"] {
      --bg-0: #eef6ff;
      --bg-1: #f8fafc;
      --bg-2: #ffffff;
      --panel: rgba(255,255,255,.90);
      --panel-solid: #ffffff;
      --panel-soft: rgba(248,250,252,.92);
      --surface: rgba(15,23,42,.04);
      --surface-strong: rgba(15,23,42,.07);
      --text: #111827;
      --text-strong: #020617;
      --muted: #64748b;
      --muted-2: #94a3b8;
      --border: rgba(15,23,42,.10);
      --border-strong: rgba(15,23,42,.18);
      --shadow: rgba(15,23,42,.10);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body { max-width: 100%; }
    html, body { overflow-x: clip; }
    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 10% -8%, rgba(34,197,94,.22), transparent 28rem),
        radial-gradient(circle at 86% 2%, rgba(56,189,248,.22), transparent 30rem),
        radial-gradient(circle at 62% 108%, rgba(167,139,250,.15), transparent 28rem),
        linear-gradient(135deg, var(--bg-0), var(--bg-1) 45%, var(--bg-2));
      color: var(--text);
      font-family: "Segoe UI", Inter, system-ui, -apple-system, BlinkMacSystemFont, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.48;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(148,163,184,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148,163,184,.035) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,.82), transparent 78%);
    }
    .page { width: min(1440px, calc(100vw - 44px)); margin: 0 auto; padding: 28px 0 38px; position: relative; overflow: visible; }
    .hero, .panel, .disk-card, .metric, .table-panel {
      border: 1px solid var(--border);
      background: var(--panel);
      box-shadow: 0 20px 60px var(--shadow);
      backdrop-filter: blur(16px);
    }
    .hero { border-radius: var(--radius-lg); padding: 28px; position: relative; overflow: hidden; }
    .hero::after { content: ""; position: absolute; inset: auto -120px -180px auto; width: 420px; height: 420px; border-radius: 999px; background: radial-gradient(circle, rgba(56,189,248,.18), transparent 65%); pointer-events: none; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: start; position: relative; z-index: 1; }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 10px; color: var(--accent); font-size: 12px; font-weight: 850; letter-spacing: .11em; text-transform: uppercase; }
    h1, h2, h3 { margin: 0; color: var(--text-strong); }
    h1 { font-size: clamp(32px, 4.4vw, 56px); letter-spacing: -.06em; line-height: .98; }
    h2 { font-size: 20px; letter-spacing: -.02em; }
    h3 { font-size: 16px; letter-spacing: -.015em; }
    .subtitle { color: var(--muted); max-width: 860px; margin: 12px 0 0; font-size: 15px; }
    .status-pill, .pill, .chip, .tag { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; white-space: nowrap; }
    .status-pill { padding: 10px 14px; font-weight: 900; font-size: 12px; letter-spacing: .07em; text-transform: uppercase; border: 1px solid rgba(56,189,248,.38); background: rgba(56,189,248,.13); color: var(--info); }
    .status-pill.ok { border-color: rgba(34,197,94,.42); background: rgba(34,197,94,.14); color: var(--ok); }
    .status-pill.warning { border-color: rgba(245,158,11,.42); background: rgba(245,158,11,.14); color: var(--warning); }
    .status-pill.critical { border-color: rgba(239,68,68,.44); background: rgba(239,68,68,.14); color: var(--critical); }
    .meta-row { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 22px; position: relative; z-index: 1; }
    .chip { padding: 7px 10px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 12px; font-weight: 750; }
    .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 18px 0; min-width: 0; }
    .metric { min-height: 112px; padding: 16px; border-radius: var(--radius-md); background: linear-gradient(180deg, var(--surface-strong), var(--surface)); position: relative; overflow: hidden; }
    .metric::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); opacity: .92; }
    .metric.warn::before { background: linear-gradient(90deg, var(--warning), var(--critical)); }
    .metric-label { color: var(--muted); font-size: 11px; font-weight: 850; letter-spacing: .055em; text-transform: uppercase; }
    .metric-value { margin-top: 8px; color: var(--text-strong); font-size: clamp(21px, 2.4vw, 32px); font-weight: 950; letter-spacing: -.04em; word-break: break-word; }
    .metric-note { margin-top: 5px; color: var(--muted-2); font-size: 12px; }
    .layout {
      display: grid;
      grid-template-columns: minmax(236px, 292px) minmax(0, 1fr);
      gap: 18px;
      align-items: stretch;
      margin-top: 18px;
      min-width: 0;
      overflow: visible;
    }
    .sidebar {
      position: relative;
      align-self: stretch;
      min-width: 0;
      min-height: 100%;
      overflow: visible;
    }
    .sidebar-sticky {
      position: sticky;
      top: 18px;
      display: grid;
      gap: 14px;
      max-height: calc(100vh - 36px);
      overflow-y: auto;
      overflow-x: hidden;
      padding-right: 4px;
      scrollbar-gutter: stable;
    }
    .sidebar-sticky::-webkit-scrollbar { width: 8px; }
    .sidebar-sticky::-webkit-scrollbar-thumb { background: var(--surface-strong); border-radius: 999px; border: 2px solid transparent; background-clip: content-box; }
    .sidebar-sticky::-webkit-scrollbar-track { background: transparent; }
    .panel, .table-panel { border-radius: var(--radius-md); padding: 18px; min-width: 0; }
    .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
    .panel-subtitle { color: var(--muted); margin: 6px 0 0; font-size: 13px; }
    .search { width: 100%; border: 1px solid var(--border); border-radius: 14px; padding: 12px 13px; background: var(--surface); color: var(--text); outline: none; font-weight: 650; }
    .search:focus { border-color: rgba(56,189,248,.72); box-shadow: 0 0 0 4px rgba(56,189,248,.12); }
    .quick-links { display: grid; gap: 8px; }
    .quick-links a { color: var(--text); text-decoration: none; padding: 9px 10px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); font-weight: 750; font-size: 13px; }
    .quick-links a:hover { border-color: var(--border-strong); background: var(--surface-strong); }
    .brief-list { margin: 0; padding-left: 18px; color: var(--muted); display: grid; gap: 7px; }
    .content { display: grid; gap: 18px; min-width: 0; }
    .disk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(430px, 100%), 1fr)); gap: 16px; min-width: 0; }
    .disk-card { border-radius: var(--radius-lg); padding: 19px; background: linear-gradient(180deg, var(--panel), rgba(15,23,42,.72)); overflow: hidden; position: relative; min-width: 0; }
    .disk-card::before { content: ""; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, var(--ok), var(--accent)); opacity: .9; }
    .disk-card.warning::before { background: linear-gradient(90deg, var(--warning), var(--critical)); }
    .disk-card.critical::before { background: linear-gradient(90deg, var(--critical), #7f1d1d); }
    .disk-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: start; }
    .disk-model { font-size: 19px; font-weight: 950; color: var(--text-strong); letter-spacing: -.025em; }
    .disk-sub { margin-top: 6px; color: var(--muted); font-size: 12px; display: flex; flex-wrap: wrap; gap: 7px; }
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); font-size: 11px; font-weight: 850; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .badge.ok { border-color: rgba(34,197,94,.40); background: rgba(34,197,94,.13); color: var(--ok); }
    .badge.warning { border-color: rgba(245,158,11,.42); background: rgba(245,158,11,.13); color: var(--warning); }
    .badge.critical { border-color: rgba(239,68,68,.44); background: rgba(239,68,68,.13); color: var(--critical); }
    .disk-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; margin-top: 16px; min-width: 0; }
    .disk-kpi { border: 1px solid var(--border); border-radius: 15px; padding: 12px; background: var(--surface); min-height: 78px; }
    .kpi-label { color: var(--muted); font-size: 10px; font-weight: 850; text-transform: uppercase; letter-spacing: .055em; }
    .kpi-value { margin-top: 7px; color: var(--text-strong); font-size: 19px; font-weight: 950; letter-spacing: -.035em; }
    .life-block { margin-top: 14px; }
    .life-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 12px; font-weight: 750; margin-bottom: 8px; }
    .bar { height: 11px; overflow: hidden; border: 1px solid var(--border); border-radius: 999px; background: rgba(148,163,184,.14); }
    .bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--ok), var(--accent)); width: var(--value, 0%); }
    .bar-fill.warning { background: linear-gradient(90deg, var(--warning), var(--critical)); }
    .details-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; margin-top: 14px; min-width: 0; }
    .kv { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: 9px; padding: 9px 10px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
    .kv span:first-child { color: var(--muted); font-size: 12px; font-weight: 800; }
    .kv span:last-child { color: var(--text); font-size: 12px; font-weight: 700; overflow-wrap: anywhere; }
    details.table-panel summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    details.table-panel summary::-webkit-details-marker { display: none; }
    .table-wrap { overflow-x: auto; overflow-y: visible; max-width: 100%; border-radius: 14px; border: 1px solid var(--border); margin-top: 14px; }
    table { width: max-content; min-width: 100%; border-collapse: collapse; background: rgba(2,6,23,.16); }
    th, td { padding: 10px 11px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; max-width: 260px; overflow-wrap: anywhere; }
    th { position: sticky; top: 0; z-index: 2; background: var(--panel-solid); color: var(--muted); font-size: 11px; letter-spacing: .055em; text-transform: uppercase; }
    td { color: var(--text); font-size: 12px; }
    .quick-links a, .chip, .badge, .kv span { min-width: 0; overflow-wrap: anywhere; }
    tr:hover td { background: var(--surface); }
    .empty { color: var(--muted); padding: 16px; border: 1px dashed var(--border-strong); border-radius: 14px; background: var(--surface); }
    .footer { color: var(--muted-2); font-size: 12px; margin-top: 22px; text-align: center; }
    code { color: var(--accent); background: var(--surface); border: 1px solid var(--border); padding: 2px 6px; border-radius: 8px; }

    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { position: static; min-height: auto; }
      .sidebar-sticky { position: static; max-height: none; overflow: visible; padding-right: 0; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
      .disk-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 760px) { .page { width: min(100vw - 22px, 1440px); padding-top: 16px; } .hero-grid { grid-template-columns: 1fr; } .metrics, .disk-kpis, .details-grid { grid-template-columns: 1fr; } h1 { font-size: 34px; } .hero, .panel, .table-panel, .disk-card { padding: 16px; } .kv { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
{% set disks = data.disks if data.disks is iterable else [] %}
{% set warnings = summary.warnings_count | default(0) %}
{% set limited = summary.limited_count | default(0) %}
{% set critical = summary.critical_count | default(0) %}
{% set alert_count = warnings + limited + critical %}
{% set status = (summary.status | default(document.status) | string | lower) %}
{% if critical > 0 %}{% set status_class = 'critical' %}{% elif alert_count > 0 %}{% set status_class = 'warning' %}{% elif status == 'ok' %}{% set status_class = 'ok' %}{% else %}{% set status_class = '' %}{% endif %}
<div class="page">
  <header class="hero">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">▰ Storage Health · {{ meta.report_type | default('disk_smart') }}</div>
        <h1>{{ document.title }}</h1>
        <p class="subtitle">{{ document.subtitle }}</p>
      </div>
      <div class="status-pill {{ status_class }}">Estado {{ summary.status | default(document.status) }}</div>
    </div>
    <div class="meta-row">
      <span class="chip">Herramienta: {{ meta.tool_name | default('N/A') }}</span>
      <span class="chip">Equipo: {{ meta.computer_name | default('N/A') }}</span>
      <span class="chip">Usuario: {{ meta.user_name | default('N/A') }}</span>
      <span class="chip">Generado: {{ meta.generated_at | default('N/A') }}</span>
      <span class="chip">Fuente: {{ meta.source | default('N/A') }}</span>
    </div>
  </header>

  <section class="metrics">
    <div class="metric"><div class="metric-label">Discos</div><div class="metric-value">{{ summary.disk_count | default(disks|length) }}</div><div class="metric-note">Dispositivos únicos evaluados</div></div>
    <div class="metric"><div class="metric-label">OK</div><div class="metric-value">{{ summary.ok_count | default(0) }}</div><div class="metric-note">Sin hallazgos críticos</div></div>
    <div class="metric {% if alert_count > 0 %}warn{% endif %}"><div class="metric-label">Alertas</div><div class="metric-value">{{ alert_count }}</div><div class="metric-note">Limitados + warnings + críticos</div></div>
    <div class="metric"><div class="metric-label">Temperatura máxima</div><div class="metric-value">{{ summary.max_temperature_c | default('N/A') }}{% if summary.max_temperature_c is not none %}°C{% endif %}</div><div class="metric-note">Máximo detectado</div></div>
    <div class="metric"><div class="metric-label">Entradas detectadas</div><div class="metric-value">{{ summary.detected_entry_count | default(disks|length) }}</div><div class="metric-note">Antes de unificar duplicados</div></div>
    <div class="metric"><div class="metric-label">smartctl</div><div class="metric-value">{% if data.smartctl.available %}OK{% else %}N/A{% endif %}</div><div class="metric-note">{{ data.smartctl.message | default('Disponible para lectura SMART', true) }}</div></div>
  </section>

  <main class="layout">
    <aside class="sidebar">
      <div class="sidebar-sticky">
      <section class="panel">
        <div class="panel-title"><h2>Buscar</h2></div>
        <input id="searchInput" class="search" type="search" placeholder="Filtrar por modelo, serie, familia o dispositivo...">
        <p class="panel-subtitle">Filtra las tarjetas y la tabla principal sin modificar el informe.</p>
      </section>
      <section class="panel">
        <div class="panel-title"><h2>Navegación</h2></div>
        <nav class="quick-links">
          <a href="#disks">Discos evaluados</a>
          <a href="#table-data_disks">Tabla de discos</a>
          <a href="#table-data_ata_attributes">Atributos ATA</a>
          <a href="#table-data_nvme_health_metrics">Métricas NVMe</a>
        </nav>
      </section>
      <section class="panel">
        <div class="panel-title"><h2>Brief técnico</h2></div>
        {% if report_brief.findings or report_brief.recommendations or report_brief.technician_notes %}
          {% if report_brief.findings %}<h3>Hallazgos</h3><ul class="brief-list">{% for item in report_brief.findings %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
          {% if report_brief.recommendations %}<h3 style="margin-top:14px">Recomendaciones</h3><ul class="brief-list">{% for item in report_brief.recommendations %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
          {% if report_brief.technician_notes %}<h3 style="margin-top:14px">Notas</h3><ul class="brief-list">{% for item in report_brief.technician_notes %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
        {% else %}
          <p class="panel-subtitle">Sin observaciones adicionales declaradas en <code>report_brief</code>.</p>
        {% endif %}
      </section>
      <section class="panel">
        <div class="panel-title"><h2>smartctl</h2></div>
        <p class="panel-subtitle">Estado: <strong>{% if data.smartctl.available %}disponible{% else %}no disponible{% endif %}</strong></p>
        {% if data.smartctl.path %}<p class="panel-subtitle">Ruta:<br><code>{{ data.smartctl.path }}</code></p>{% endif %}
      </section>
      </div>
    </aside>

    <section class="content">
      <section id="disks" class="disk-grid">
        {% for disk in disks %}
          {% set disk_status = disk.evaluation_status | default('Unknown') %}
          {% set disk_status_lower = disk_status | string | lower %}
          {% set card_class = 'critical' if disk_status_lower == 'critical' else ('warning' if disk_status_lower in ['warning','limited'] else '') %}
          {% set life = disk.life if disk.life is mapping else {} %}
          {% set remaining = life.remaining_percent if life.remaining_percent is not none else none %}
          {% set used = life.used_percent if life.used_percent is not none else none %}
          {% set search_text = (disk.model|string ~ ' ' ~ disk.serial|string ~ ' ' ~ disk.storage_family|string ~ ' ' ~ disk.detected_type|string ~ ' ' ~ disk.smart_device|string)|lower %}
          <article class="disk-card {{ card_class }}" data-search="{{ search_text }}">
            <div class="disk-head">
              <div>
                <div class="disk-model">{{ disk.model | default('Modelo no informado') }}</div>
                <div class="disk-sub">
                  <span>{{ disk.storage_family | default(disk.detected_type | default('Familia N/A')) }}</span>
                  <span>·</span>
                  <span>{{ disk.smart_device | default('SMART N/A') }}</span>
                  {% if disk.deduplicated %}<span>· Entrada unificada</span>{% endif %}
                </div>
              </div>
              <span class="badge {{ 'ok' if disk_status_lower == 'ok' else card_class }}">{{ disk_status }}</span>
            </div>
            <div class="disk-kpis">
              <div class="disk-kpi"><div class="kpi-label">Temp</div><div class="kpi-value">{{ disk.temperature_c | default('N/A') }}{% if disk.temperature_c is not none %}°C{% endif %}</div></div>
              <div class="disk-kpi"><div class="kpi-label">Horas</div><div class="kpi-value">{{ disk.power_on_hours | default('N/A') }}</div></div>
              <div class="disk-kpi"><div class="kpi-label">Vida</div><div class="kpi-value">{% if remaining is not none %}{{ remaining }}%{% else %}N/A{% endif %}</div></div>
              <div class="disk-kpi"><div class="kpi-label">SMART</div><div class="kpi-value">{% if disk.smart_global_passed is sameas true %}PASS{% elif disk.smart_global_passed is sameas false %}FAIL{% else %}N/A{% endif %}</div></div>
            </div>
            <div class="life-block">
              <div class="life-row"><span>Desgaste reportado</span><span>{% if used is not none %}{{ used }}% usado{% else %}Sin dato{% endif %}</span></div>
              <div class="bar"><div class="bar-fill {% if remaining is not none and remaining < 70 %}warning{% endif %}" style="--value: {{ remaining if remaining is not none else 0 }}%"></div></div>
            </div>
            <div class="details-grid">
              <div class="kv"><span>Serie</span><span>{{ disk.serial | default('N/A') }}</span></div>
              <div class="kv"><span>Firmware</span><span>{{ disk.firmware | default('N/A') }}</span></div>
              <div class="kv"><span>Nivel datos</span><span>{{ disk.data_level | default('N/A') }}</span></div>
              <div class="kv"><span>Exit code</span><span>{{ disk.smartctl_exit_code | default('N/A') }}</span></div>
              <div class="kv"><span>Fuente vida</span><span>{{ life.source | default('N/A') }}</span></div>
              <div class="kv"><span>Alternativos</span><span>{% if disk.alternate_smart_devices %}{{ disk.alternate_smart_devices | join(', ') }}{% else %}-{% endif %}</span></div>
            </div>
          </article>
        {% endfor %}
      </section>

      {% for table in document.tables %}
        <details id="table-{{ table.name }}" class="table-panel" {% if loop.index <= 2 %}open{% endif %}>
          <summary>
            <div>
              <h2>{{ table.title }}</h2>
              <p class="panel-subtitle">{{ table.rows | length }} filas · fuente <code>{{ table.source_path }}</code></p>
            </div>
            <span class="badge">{{ table.name }}</span>
          </summary>
          {% if table.rows %}
            <div class="table-wrap">
              <table>
                <thead><tr>{% for column in table.columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
                <tbody>
                  {% for row in table.rows %}
                    {% set row_search = row.values() | join(' ') | lower %}
                    <tr data-search="{{ row_search }}">{% for column in table.columns %}<td>{{ row.get(column, '') | render_value }}</td>{% endfor %}</tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="empty">No hay filas para esta tabla.</div>
          {% endif %}
        </details>
      {% endfor %}

      {% if diagnostics %}
        <section class="table-panel"><h2>Diagnósticos</h2><pre>{{ diagnostics | render_value }}</pre></section>
      {% endif %}
      {% if errors %}
        <section class="table-panel"><h2>Errores</h2><pre>{{ errors | render_value }}</pre></section>
      {% endif %}
    </section>
  </main>
  <footer class="footer">RenderCore {{ meta.tool_name | default('') }} · contrato JSON estándar · {{ meta.generated_at | default('') }}</footer>
</div>
<script>
  const input = document.getElementById('searchInput');
  const searchable = Array.from(document.querySelectorAll('[data-search]'));
  input?.addEventListener('input', () => {
    const term = input.value.trim().toLowerCase();
    searchable.forEach(el => {
      const ok = !term || (el.dataset.search || '').includes(term);
      el.style.display = ok ? '' : 'none';
    });
  });
</script>
</body>
</html>
