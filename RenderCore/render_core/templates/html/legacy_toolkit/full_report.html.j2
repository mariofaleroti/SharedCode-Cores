{#
    full_report.html.j2

    Envoltorio del reporte completo.

    Este archivo no duplica el HTML interno de cada reporte.
    Reutiliza las secciones existentes dentro de report_sections.

    El JSON full_report contiene:
    - data.Hardware
    - data.Software
    - data.Network
    - data.SystemExtras

    Cada seccion espera variables simples:
    - meta
    - summary
    - data
    - diagnostics
    - errors

    Por eso antes de incluir cada seccion se prepara su contexto.
#}

{% extends "report_base.html.j2" %}

{% import "components/summary_card.html.j2" as summary_card %}

{% block report_page_title %}Reporte Completo - Toolkit IT{% endblock %}

{% block report_title %}
    {{ meta.tool_name | default("Toolkit IT") }} - Reporte Completo
{% endblock %}

{% block report_styles %}
    .hardware-panel-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 18px;
    }

    .network-panel-grid,
    .software-panel-grid,
    .extras-panel-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .network-wide-panel,
    .software-wide-panel,
    .extras-wide-panel {
        grid-column: 1 / -1;
    }

  .full-section-separator {
    margin: 18px 0 10px;
    padding: 8px 12px;
    background: #f8fafc;
    color: #111827;
    border: 1px solid var(--border-light);
    border-left: 5px solid #111827;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 800;
}

    @media (max-width: 900px) {
        .hardware-panel-grid,
        .network-panel-grid,
        .software-panel-grid,
        .extras-panel-grid {
            grid-template-columns: 1fr;
        }
    }
{% endblock %}

{% block content %}

{% set full_meta = meta %}
{% set full_summary = summary %}
{% set full_data = data %}
{% set full_diagnostics = diagnostics | default([]) %}
{% set full_errors = errors | default([]) %}

<div class="overview-grid">
    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
            Resumen general
        </h2>

        <div class="summary-card-grid">
            {% call summary_card.render_summary_card("Estado", full_summary.status | default("N/A")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 6 9 17l-5-5"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Discos", full_summary.hardware_disk_count | default("N/A")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
                    <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Programas", full_summary.installed_program_count | default("N/A")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 6h13"></path>
                    <path d="M8 12h13"></path>
                    <path d="M8 18h13"></path>
                    <path d="M3 6h.01"></path>
                    <path d="M3 12h.01"></path>
                    <path d="M3 18h.01"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Adaptadores", full_summary.active_adapter_count | default("N/A")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="16" height="10" rx="2"></rect>
                    <path d="M8 20h8"></path>
                    <path d="M12 14v6"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Avisos", full_summary.warnings_count | default(0), "warning") %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
            {% endcall %}
        </div>

        <div class="summary-meta-line">
            <span>Criticos: {{ full_summary.critical_count | default(0) }}</span>
            <span>Recolectado: {{ full_data.CollectedAt | default("N/A") }}</span>
            <span>Modulo: {{ full_meta.module_name | default("N/A") }}</span>
        </div>
    </section>

    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
            </svg>
            Diagnosticos generales
        </h2>

        {% include "components/diagnostics.html.j2" %}
    </section>
</div>

{% include "components/errors.html.j2" %}

<div class="full-section-separator">Hardware</div>

{% set hardware_meta = {
    "tool_name": full_meta.tool_name | default("Toolkit IT"),
    "module_name": "ReportsHardware",
    "report_type": "hardware"
} %}

{% set hardware_summary = {
    "cpu_name": full_data.Hardware.Cpu.Name | default("N/A"),
    "memory_total_gb": full_data.Hardware.Memory.TotalGB | default("N/A"),
    "disk_count": full_data.Hardware.Disks | length if full_data.Hardware.Disks else 0,
    "warnings_count": full_summary.warnings_count | default(0),
    "critical_count": full_summary.critical_count | default(0)
} %}

{% with meta=hardware_meta, summary=hardware_summary, data=full_data.Hardware, diagnostics=[], errors=[],embedded_report=true %}
    {% include "report_sections/hardware_content.html.j2" %}
{% endwith %}

<div class="full-section-separator">Red</div>

{% set network_meta = {
    "tool_name": full_meta.tool_name | default("Toolkit IT"),
    "module_name": "ReportsNetwork",
    "report_type": "network"
} %}

{% set network_summary = {
    "status": full_summary.status | default("N/A"),
    "active_adapter_count": full_summary.active_adapter_count | default("N/A"),
    "ip_configuration_count": full_data.Network.IPConfigurations | length if full_data.Network.IPConfigurations else 0,
    "local_share_count": full_data.Network.LocalShares | length if full_data.Network.LocalShares else 0,
    "domain_or_workgroup": full_data.Network.DomainInfo.DomainOrWorkgroup | default("N/A"),
    "warnings_count": 0,
    "critical_count": 0
} %}

{% with meta=network_meta, summary=network_summary, data=full_data.Network, diagnostics=[], errors=[],embedded_report=true %}
    {% include "report_sections/network_content.html.j2" %}
{% endwith %}

<div class="full-section-separator">Software</div>

{% set software_meta = {
    "tool_name": full_meta.tool_name | default("Toolkit IT"),
    "module_name": "ReportsSoftware",
    "report_type": "software"
} %}

{% set software_summary = {
    "status": full_summary.status | default("N/A"),
    "installed_program_count": full_summary.installed_program_count | default("N/A"),
    "hotfix_count": full_summary.hotfix_count | default("N/A"),
    "item_count": full_summary.installed_program_count | default("N/A"),
    "warnings_count": 0,
    "critical_count": 0
} %}

{% with meta=software_meta, summary=software_summary, data=full_data.Software, diagnostics=[], errors=[],embedded_report=true %}
    {% include "report_sections/software_content.html.j2" %}
{% endwith %}

<div class="full-section-separator">Extras del sistema</div>

{% set extras_meta = {
    "tool_name": full_meta.tool_name | default("Toolkit IT"),
    "module_name": "ReportsSystemExtras",
    "report_type": "system_extras"
} %}

{% set extras_summary = {
    "status": full_summary.status | default("N/A"),
    "printer_count": full_summary.printer_count | default(0),
    "antivirus_count": full_summary.antivirus_count | default(0),
    "item_count": (full_summary.printer_count | default(0)) + (full_summary.antivirus_count | default(0)),
    "warnings_count": 0,
    "critical_count": 0
} %}

{% with meta=extras_meta, summary=extras_summary, data=full_data.SystemExtras, diagnostics=[], errors=[],embedded_report=true %}
    {% include "report_sections/extras_content.html.j2" %}
{% endwith %}

{% endblock %}