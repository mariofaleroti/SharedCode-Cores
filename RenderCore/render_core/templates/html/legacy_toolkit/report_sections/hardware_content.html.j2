{#
    hardware_content.html.j2

    Contenido interno del reporte de hardware.

    Este archivo no define:
    - base HTML
    - titulo de pagina
    - encabezado
    - footer
    - estilos propios del wrapper

    Solo contiene el cuerpo visual del reporte:
    - resumen
    - diagnosticos
    - errores
    - paneles de hardware
    - tablas de hardware

    Puede ser incluido por:
    - hardware_report.html.j2
    - full_report.html.j2 en el futuro
#}

{% import "components/summary_card.html.j2" as summary_card %}
{% set embedded_report = embedded_report | default(false) %}

{% if not embedded_report %}

<div class="overview-grid">
    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
            Resumen
        </h2>

        <div class="summary-card-grid">
            {# Summary card: CPU #}
            {% set cpu_summary_value = summary.cpu_name | default("N/A") | replace("Intel(R) Core(TM) ", "") | replace(" CPU @ 3.20GHz", "") %}

            {% call summary_card.render_summary_card("CPU", cpu_summary_value) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                    <path d="M9 9h6v6H9z"></path>
                </svg>
            {% endcall %}

            {# Summary card: RAM #}
            {% set ram_summary_value = summary.memory_total_gb | default("N/A") ~ " GB" %}

            {% call summary_card.render_summary_card("RAM", ram_summary_value) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="5" y="8" width="14" height="8" rx="1"></rect>
                    <path d="M7 4v4"></path>
                    <path d="M11 4v4"></path>
                    <path d="M15 4v4"></path>
                    <path d="M7 16v4"></path>
                    <path d="M11 16v4"></path>
                    <path d="M15 16v4"></path>
                </svg>
            {% endcall %}

            {# Summary card: Disks #}
            {% set disk_summary_value = summary.disk_count | default("N/A") %}

            {% call summary_card.render_summary_card("Discos", disk_summary_value) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
                    <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
                </svg>
            {% endcall %}

            {# Summary card: Warnings #}
            {% set warnings_summary_value = summary.warnings_count | default(0) %}

            {% call summary_card.render_summary_card("Avisos", warnings_summary_value, "warning") %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
            {% endcall %}

            {# Summary card: Critical #}
            {% set critical_summary_value = summary.critical_count | default(0) %}

            {% call summary_card.render_summary_card("Criticos", critical_summary_value, "critical") %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M15 9 9 15"></path>
                    <path d="M9 9l6 6"></path>
                </svg>
            {% endcall %}
        </div>

        <div class="summary-meta-line">
            <span>Recolectado: {{ data.CollectedAt | default("N/A") }}</span>
            <span>Modulo: {{ meta.module_name | default("N/A") }}</span>
        </div>
    </section>

    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
            </svg>
            Diagnosticos
        </h2>

        {% include "components/diagnostics.html.j2" %}
    </section>
</div>

{% include "components/errors.html.j2" %}

{% endif %}

<details class="section collapsible-section" id="hardware-section" open>
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="4" width="16" height="16" rx="2"></rect>
            <path d="M9 9h6v6H9z"></path>
            <path d="M9 1v3"></path>
            <path d="M15 1v3"></path>
            <path d="M9 20v3"></path>
            <path d="M15 20v3"></path>
            <path d="M20 9h3"></path>
            <path d="M20 15h3"></path>
            <path d="M1 9h3"></path>
            <path d="M1 15h3"></path>
        </svg>
        Hardware
        </summary>

    <div class="collapsible-body">

    <div class="hardware-panel-grid">
        <div class="detail-panel">
            <h3 class="detail-panel-title">Equipo y placa madre</h3>

            <table class="detail-table">
           <tbody>
    <tr>
        <th>Fabricante</th>
        <td>{{ data.Computer.Manufacturer | default("No informado") }}</td>
    </tr>
    <tr>
        <th>Modelo equipo</th>
        <td>{{ data.Computer.Model | default("No informado") }}</td>
    </tr>
    <tr>
        <th>Serie</th>
        <td>{{ data.Computer.SerialNumber | default("No informado") }}</td>
    </tr>
    <tr>
        <th>Placa madre</th>
        <td>{{ data.Motherboard.Model | default("No informado") }}</td>
    </tr>
    <tr>
        <th>Version placa</th>
        <td>{{ data.Motherboard.Version | default("No informado") }}</td>
    </tr>
    <tr>
        <th>BIOS</th>
        <td>{{ data.Bios.DisplayName | default("No informado") }}</td>
    </tr>
    <tr>
        <th>Fecha BIOS</th>
        <td>{{ data.Bios.ReleaseDate | default("No informado") }}</td>
    </tr>
</tbody>
            </table>
        </div>

        <div class="detail-panel" id="cpu-section">
            <h3 class="detail-panel-title">Procesador</h3>

            <table class="detail-table">
                <tbody>
                    <tr>
    <th>Modelo</th>
    <td>{{ data.Cpu.DisplayName | default(data.Cpu.Name | default("N/A")) }}</td>
</tr>

<tr>
    <th>Socket</th>
    <td>{{ data.Cpu.Socket | default("N/A") }}</td>
</tr>
<tr>
    <th>Velocidad GHz</th>
    <td>{{ data.Cpu.MaxClockSpeedGHz | default("N/A") }}</td>
</tr>
<tr>
    <th>Nucleos</th>
    <td>{{ data.Cpu.NumberOfCores | default("N/A") }}</td>
</tr>
<tr>
    <th>Logicos</th>
    <td>{{ data.Cpu.LogicalProcessors | default("N/A") }}</td>
</tr>
<tr>
    <th>Cache L2</th>
    <td>   {% if data.Cpu.L2CacheMB %}
            {{ data.Cpu.L2CacheMB }} MB
        {% else %}
            N/A
        {% endif %}
    </td>
</tr>
<tr>
    <th>Cache L3</th>
    <td>
        {% if data.Cpu.L3CacheMB %}
            {{ data.Cpu.L3CacheMB }} MB
        {% else %}
            N/A
        {% endif %}
    </td>
</tr>
                </tbody>
            </table>
        </div>

        <div class="detail-panel {% if data.Memory.Status == "Critical" %}panel-status-critical{% elif data.Memory.Status == "Warning" %}panel-status-warning{% endif %}" id="memory-section">
            <h3 class="detail-panel-title">Memoria</h3>

            <table class="detail-table">
                <tbody>
                    <tr class="{% if data.Memory.Status == "Critical" or data.Memory.Status == "Warning" %}status-focus-row{% endif %}">
                        <th>Total GB</th>
                        <td>{{ data.Memory.TotalGB | default("N/A") }}</td>
                    </tr>
                    <tr>
                        <th>Modulos</th>
                        <td>{{ data.Memory.ModuleCount | default("N/A") }}</td>
                    </tr>
                    <tr>
                        <th>Tecnologia</th>
                        <td>{{ data.Memory.Type | default("N/A") }}</td>
                    </tr>
                    <tr>
                        <th>Velocidad MHz</th>
                        <td>{{ data.Memory.SpeedMHz | default("N/A") }}</td>
                    </tr>
                    <tr>
                        <th>Disposición</th>
                        <td>{{ data.Memory.ModuleLayout | default("N/A") }}</td>
                    </tr>
  <tr>
    <th>Slots usados</th>
    <td>{{ data.Memory.UsedSlots | default("N/A") }}</td>
</tr>
<tr>
    <th>Slots libres</th>
    <td>{{ data.Memory.FreeSlots | default("N/A") }}</td>
</tr>
                </tbody>
            </table>
        </div>
    </div>
    </div>
</details>



<details class="section collapsible-section" id="disks-section" open>
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
            <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path>
            <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
        </svg>
        Discos
    </summary>
    <div class="collapsible-body">

    {% if data.Disks %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th class="text-center">Unidad</th>
                        <th>Etiqueta</th>
                        <th class="text-center">Tamaño (GB)</th>
                        <th class="text-center">Libre (GB)</th>
                        <th class="usage-column text-center">Porcentaje de Uso</th>
                        <th>Tipo</th>
                        <th>Bus</th>
                        <th class="text-center">Modelo</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    {% for disk in data.Disks %}
                        {% set used_percent = disk.UsedPercent | default(0) %}

                        {% if disk.Status == "Critical" %}
                            {% set usage_class = "usage-warning" %}
                        {% elif disk.Status == "Warning" %}
                            {% set usage_class = "usage-warning" %}
                        {% else %}
                            {% set usage_class = "usage-ok" %}
                        {% endif %}

                        <tr id="disk-{{ disk.Index }}" class="row-status-{{ disk.Status | default("OK") | lower }}">
                            <td>{{ disk.Index | default("N/A") }}</td>
                            <td class="text-center"><strong>{{ disk.DriveLetter | default("N/A") }}</strong></td>
                            <td>{{ disk.VolumeLabel | default("-") }}</td>
                            <td class="text-center">{{ disk.SizeGB | default("N/A") }}</td>
                            <td class="text-center">{{ disk.FreeGB | default("N/A") }}</td>
                            <td class="usage-column">
                                {% include "components/usage_bar.html.j2" %}
                            </td>
                            <td>{{ disk.MediaType | default("N/A") }}</td>
                            <td>{{ disk.BusType | default("N/A") }}</td>
                            <td>{{ disk.Model | default("N/A") }}</td>
                            <td>
                                {% if disk.Status == "Critical" %}
                                    <span class="status-inline warning">Critico</span>
                                {% elif disk.Status == "Warning" %}
                                    <span class="status-inline warning">Advertencia</span>
                                {% else %}
                                    <span class="status-inline ok">OK</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="empty-message">No disk data found.</p>
    {% endif %}
    </div>
</details>

{% set external_reports = data.ExternalReports | default(none) %}

{% if external_reports and (
    external_reports.DiskSmart.Exists | default(false) or
    external_reports.StorageAnalyzer.Exists | default(false)
) %}
    <section class="section" id="external-reports-section">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.1 0l2.8-2.8a5 5 0 0 0-7.1-7.1L11 4.9"></path>
                <path d="M14 11a5 5 0 0 0-7.1 0L4.1 13.8a5 5 0 0 0 7.1 7.1L13 19.1"></path>
            </svg>
            Análisis avanzado
        </h2>

        <div class="external-report-actions">
            {% if external_reports.DiskSmart.Exists | default(false) %}
                <a class="external-report-link"
                   href="{{ external_reports.DiskSmart.ReportPath }}"
                   target="_blank">
                    Ver Smart Disk
                </a>
            {% endif %}

            {% if external_reports.StorageAnalyzer.Exists | default(false) %}
                <a class="external-report-link"
                   href="{{ external_reports.StorageAnalyzer.ReportPath }}"
                   target="_blank">
                    Ver Storage Analyzer
                </a>
            {% endif %}
        </div>

        <p class="external-report-note">
            Análisis complementarios generados para revisar salud SMART y uso de almacenamiento.
        </p>
    </section>
{% endif %}