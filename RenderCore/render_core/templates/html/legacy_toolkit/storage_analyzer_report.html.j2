{#
    storage_analyzer_report.html.j2

    Wrapper del reporte individual de Storage Analyzer.

    Este archivo:
    - hereda de report_base.html.j2
    - define titulo, icono y estilos propios
    - incluye el contenido interno desde report_sections
#}

{% extends "report_base.html.j2" %}

{% block report_page_title %}Storage Analyzer Report - Toolkit IT{% endblock %}

{% block report_styles %}
    .storage-stack {
        display: grid;
        gap: 12px;
    }

    .storage-panel-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .storage-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .storage-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid var(--border-light);
        background: var(--bg-soft);
        color: var(--text-main);
    }

    .storage-chip.ok {
        background: var(--ok-bg);
        color: var(--ok-text);
        border-color: #bbf7d0;
    }

    .storage-chip.warning {
        background: var(--warning-bg);
        color: var(--warning-text);
        border-color: #fde68a;
    }

    .storage-chip.critical {
        background: var(--critical-bg);
        color: var(--critical-text);
        border-color: #fecaca;
    }

    .storage-path-cell {
        max-width: 420px;
        overflow-wrap: anywhere;
        color: var(--text-muted);
        font-size: 12px;
    }

    .storage-note {
        margin: 0 0 10px;
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 600;
    }

    .storage-subtitle {
        margin: 0 0 10px;
        font-size: 15px;
        font-weight: 750;
        color: var(--text-main);
    }

    @media (max-width: 900px) {
        .storage-panel-grid {
            grid-template-columns: 1fr;
        }
    }
{% endblock %}

{% block report_icon %}
    
{% endblock %}

{% block report_title %}Toolkit IT - Storage Analyzer{% endblock %}

{% block content %}
    {% include "report_sections/storage_analyzer_content.html.j2" %}
{% endblock %}
