{#
base.html.j2
Plantilla base general para cualquier HTML generado por Toolkit Render.
Este archivo sólo posee la estructura del documento común:
    -html
    - cabeza
    - variables CSS globales
    - cuerpo
    - contenedor principal
    - bloques de extensión

    No debe contener HTML específico del informe.
#}

<!DOCTYPE html>
<html lang="{% block html_lang %}es{% endblock %}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Título de la pestaña del navegador. Las plantillas secundarias pueden anular este bloque. #}
    <title>{% block title %}Toolkit IT{% endblock %}</title>

    {# Embedded SVG. Esto evita dependencias de archivos externos. #}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111827'/%3E%3Cpath d='M20 14h18l10 10v26H20z' fill='%23ffffff'/%3E%3Cpath d='M38 14v10h10' fill='%23d1d5db'/%3E%3Cpath d='M25 33h18M25 40h18M25 47h12' stroke='%23111827' stroke-width='4' stroke-linecap='round'/%3E%3C/svg%3E">

    <style>
        /* Variables de tema compartidas para todas las páginas HTML generadas. */
        :root {
            --bg-main: #f3f4f6;
            --bg-panel: #ffffff;
            --bg-soft: #f9fafb;
            --text-main: #111827;
            --text-muted: #6b7280;
            --border-light: #e5e7eb;

            --ok-bg: #dcfce7;
            --ok-text: #166534;

            --warning-bg: #fef3c7;
            --warning-text: #92400e;

            --critical-bg: #fee2e2;
            --critical-text: #991b1b;

            --info-bg: #dbeafe;
            --info-text: #1e40af;
        }

        /* Keep width calculations predictable. */
        * {
            box-sizing: border-box;
        }

        /* Mantenga los cálculos de ancho predecibles. */
        body {
            margin: 0;
            background: var(--bg-main);
            color: var(--text-main);
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 14px;
            line-height: 1.35;
        }

     /*
    Scrollbar global.

    Aplica a la pagina principal y tambien a contenedores internos
    que tengan scroll propio.
*/
* {
    scrollbar-width: thin;
    scrollbar-color: #9ca3af #e5e7eb;
}

*::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

*::-webkit-scrollbar-track {
    background: #e5e7eb;
}

*::-webkit-scrollbar-thumb {
    background: #9ca3af;
    border-radius: 999px;
    border: 2px solid #e5e7eb;
}

*::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
}

        /* Envoltorio de la página principal. Las plantillas secundarias pueden anular main_class. */
        .page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 14px 18px 22px;
        }

        /* helper de icono SVG genérico.*/
        .icon {
            width: 20px;
            height: 20px;
            flex: 0 0 auto;
        }

        @media (max-width: 600px) {
            .page {
                padding: 10px;
            }
        }

        @media print {
            body {
                background: #ffffff;
            }

            .page {
                max-width: none;
                padding: 0;
            }
        }

        {# Extra CSS provided by child templates. #}
        {% block styles %}{% endblock %}
    </style>

    {# Contenido adicional opcional dentro del cabezal. #}
    {% block head_extra %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}">
    <main class="{% block main_class %}page{% endblock %}">
        {% block page_content %}{% endblock %}
    </main>

    {# Scripts opcionales antes de cerrar el cuerpo. #}
    {% block scripts %}{% endblock %}
</body>
</html>
