{#
    storage_analyzer_content.html.j2

    Contenido interno del reporte de Storage Analyzer.

    Este archivo no define:
    - base HTML
    - titulo de pagina
    - encabezado
    - footer
    - estilos propios del wrapper

    Solo contiene el cuerpo visual del reporte:
    - resumen
    - diagnosticos
    - errores
    - items principales
    - inventario de respaldos
    - resumen por extensiones
#}

{% import "components/summary_card.html.j2" as summary_card %}

{% set error_count = summary.error_count | default(0) %}
{% set critical_count = summary.critical_count | default(0) %}
{% set warning_count = summary.warning_count | default(0) %}
{% set alert_count = critical_count + warning_count %}
{% set backup_count = summary.backup_inventory_count | default(0) %}
{% set reliability = summary.reliability | default("Unknown") %}

<div class="overview-grid">
    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
            Resumen
        </h2>

        <div class="summary-card-grid">
            {% call summary_card.render_summary_card("Total", summary.total_size_formatted | default("N/A")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
                    <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Items", summary.item_count | default(0)) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h16"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Alertas", alert_count, "critical" if critical_count > 0 else ("warning" if alert_count > 0 else "")) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Respaldos", backup_count) %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 7h16v11H4z"></path>
                    <path d="M8 7V5h8v2"></path>
                    <path d="M8 13h8"></path>
                </svg>
            {% endcall %}

            {% call summary_card.render_summary_card("Errores", error_count, "critical" if error_count > 0 else "") %}
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    {% if error_count > 0 %}
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M15 9 9 15"></path>
                        <path d="M9 9l6 6"></path>
                    {% else %}
                        <path d="M20 6 9 17l-5-5"></path>
                    {% endif %}
                </svg>
            {% endcall %}
        </div>

        <div class="summary-meta-line">
            <span>Ruta: {{ summary.scan_path | default(data.scan_path | default("N/A")) }}</span>
            <span>Confiabilidad: {{ reliability }}</span>
            <span>Version: {{ meta.version | default("N/A") }}</span>
        </div>
    </section>

    <section class="overview-panel">
        <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
                <path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
            </svg>
            Diagnosticos
        </h2>

        {% include "components/diagnostics.html.j2" %}
    </section>
</div>

{% include "components/errors.html.j2" %}

<details class="section collapsible-section" id="storage-summary-section" open>
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3"></path>
        </svg>
        Analisis general
    </summary>

    <div class="collapsible-body">
        {% set largest_item = summary.largest_item | default({}) %}

        {% if critical_count > 0 %}
            {% set finding_panel_class = "panel-status-critical" %}
            {% set finding_status = "Critico" %}
        {% elif warning_count > 0 %}
            {% set finding_panel_class = "panel-status-warning" %}
            {% set finding_status = "Advertencia" %}
        {% else %}
            {% set finding_panel_class = "" %}
            {% set finding_status = "OK" %}
        {% endif %}

        <div class="detail-panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
            <div class="detail-panel">
                <h3 class="detail-panel-title">Datos base</h3>

                <table class="detail-table">
                    <tbody>
                        <tr>
                            <th>Ruta</th>
                            <td>{{ summary.scan_path | default(data.scan_path | default("N/A")) }}</td>
                        </tr>
                        <tr>
                            <th>Total</th>
                            <td>{{ summary.total_size_formatted | default("N/A") }}</td>
                        </tr>
                        <tr>
                            <th>Items</th>
                            <td>{{ summary.item_count | default("N/A") }}</td>
                        </tr>
                        <tr>
                            <th>Errores</th>
                            <td>{{ error_count }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="detail-panel">
                <h3 class="detail-panel-title">Uso y composicion</h3>

                <table class="detail-table">
                    <tbody>
                        <tr>
                            <th>Top analizado</th>
                            <td>{{ summary.top_count | default("N/A") }}</td>
                        </tr>
                        <tr>
                            <th>Peso del top</th>
                            <td>{{ summary.top_items_size_formatted | default("N/A") }} ({{ summary.top_items_percent | default("N/A") }}%)</td>
                        </tr>
                        <tr>
                            <th>Otros items</th>
                            <td>{{ summary.other_items_size_formatted | default("N/A") }} ({{ summary.other_items_percent | default("N/A") }}%)</td>
                        </tr>
                        <tr>
                            <th>Confiabilidad</th>
                            <td>{{ reliability }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="detail-panel {{ finding_panel_class }}">
                <h3 class="detail-panel-title">Hallazgo principal</h3>

                <table class="detail-table">
                    <tbody>
                        <tr class="status-focus-row">
                            <th>Estado</th>
                            <td>{{ finding_status }}</td>
                        </tr>
                        <tr>
                            <th>Mayor item</th>
                            <td>{{ largest_item.name | default("N/A") }}</td>
                        </tr>
                        <tr>
                            <th>Tamano</th>
                            <td>{{ largest_item.size_formatted | default(largest_item.sizeFormatted | default("N/A")) }}</td>
                        </tr>
                        <tr>
                            <th>Ruta</th>
                            <td>{{ largest_item.path | default("N/A") }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</details>

<details class="section collapsible-section" id="storage-top-items-section" open>
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19V5"></path>
            <path d="M8 19v-8"></path>
            <path d="M12 19v-5"></path>
            <path d="M16 19V8"></path>
            <path d="M20 19v-3"></path>
        </svg>
        Items principales
    </summary>

    <div class="collapsible-body">
        {% if data.top_items %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Categoria</th>
                            <th>Tamano</th>
                            <th>Uso</th>
                            <th>Estado</th>
                            <th>Edad</th>
                            <th>Ruta</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in data.top_items %}
                            {% set used_percent = item.percent | default(0) %}

                            {% if item.status == "Critical" %}
                                {% set usage_class = "usage-warning" %}
                                {% set row_class = "row-status-critical" %}
                            {% elif item.status == "High" %}
                                {% set usage_class = "usage-medium" %}
                                {% set row_class = "row-status-warning" %}
                            {% else %}
                                {% set usage_class = "usage-ok" %}
                                {% set row_class = "" %}
                            {% endif %}

                            <tr id="storage-item-{{ loop.index }}" class="{{ row_class }}">
                                <td>{{ loop.index }}</td>
                                <td><strong>{{ item.name | default("N/A") }}</strong></td>
                                <td>{{ item.type | default("N/A") }}</td>
                                <td>{{ item.category | default("N/A") }}</td>
                                <td>{{ item.sizeFormatted | default("N/A") }}</td>
                                <td>
                                    {% include "components/usage_bar.html.j2" %}
                                </td>
                                <td>
                                    {% if item.status == "Critical" %}
                                        <span class="status-badge status-critical">Critico</span>
                                    {% elif item.status == "High" %}
                                        <span class="status-badge status-warning">Alto</span>
                                    {% else %}
                                        <span class="status-badge status-ok">Normal</span>
                                    {% endif %}
                                </td>
                                <td>{{ item.modifiedAgeDays | default("N/A") }} dias</td>
                                <td class="storage-path-cell">{{ item.path | default("N/A") }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty-message">No se encontraron items para mostrar.</p>
        {% endif %}
    </div>
</details>

<details class="section collapsible-section" id="backup-inventory-section" open>
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16v11H4z"></path>
            <path d="M8 7V5h8v2"></path>
            <path d="M8 13h8"></path>
        </svg>
        Inventario de respaldos
    </summary>

    <div class="collapsible-body">
        {% set inventory = data.backup_inventory | default({}) %}

        {% if inventory and inventory.totalItems %}
            <div class="detail-panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); margin-bottom: 12px;">
                <div class="detail-panel">
                    <h3 class="detail-panel-title">Resumen del inventario</h3>

                    <table class="detail-table">
                        <tbody>
                            <tr>
                                <th>Respaldos</th>
                                <td>{{ inventory.totalItems | default(0) }}</td>
                            </tr>
                            <tr>
                                <th>Tamano total</th>
                                <td>{{ inventory.totalSizeFormatted | default("N/A") }}</td>
                            </tr>
                            <tr>
                                <th>Mayor item</th>
                                <td>{{ inventory.largestItemName | default("N/A") }}</td>
                            </tr>
                            <tr>
                                <th>Tamano mayor</th>
                                <td>{{ inventory.largestItemSizeFormatted | default("N/A") }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="detail-panel">
                    <h3 class="detail-panel-title">Lectura rapida</h3>

                    <table class="detail-table">
                        <tbody>
                            <tr>
                                <th>Mas reciente</th>
                                <td>{{ inventory.newestItemName | default("N/A") }} ({{ inventory.newestItemAgeDays | default("N/A") }} dias)</td>
                            </tr>
                            <tr>
                                <th>Mas antiguo</th>
                                <td>{{ inventory.oldestItemName | default("N/A") }} ({{ inventory.oldestItemAgeDays | default("N/A") }} dias)</td>
                            </tr>
                            <tr>
                                <th>Confianza</th>
                                <td>
                                    High: {{ inventory.highConfidenceCount | default(0) }} |
                                    Medium: {{ inventory.mediumConfidenceCount | default(0) }} |
                                    Low: {{ inventory.lowConfidenceCount | default(0) }}
                                </td>
                            </tr>
                            <tr>
                                <th>Criterio</th>
                                <td>Detectado por nombre, tipo, extension o ubicacion.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {% set inventory_items = inventory["items"] | default([]) %}
            {% if inventory_items %}
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Backup</th>
                                <th>Confianza</th>
                                <th>Tamano</th>
                                <th>Edad</th>
                                <th>Ruta</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for item in inventory_items %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td><strong>{{ item.name | default("N/A") }}</strong></td>
                                    <td>{{ item.type | default("N/A") }}</td>
                                    <td>{{ item.backupType | default("N/A") }}</td>
                                    <td>{{ item.confidence | default("N/A") }}</td>
                                    <td>{{ item.sizeFormatted | default("N/A") }}</td>
                                    <td>{{ item.modifiedAgeDays | default("N/A") }} dias</td>
                                    <td class="storage-path-cell">{{ item.path | default("N/A") }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% else %}
            <p class="empty-message">No se detectaron candidatos de respaldo.</p>
        {% endif %}
    </div>
</details>

<details class="section collapsible-section" id="extension-summary-section">
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <path d="M14 2v6h6"></path>
        </svg>
        Extensiones detectadas
    </summary>

    <div class="collapsible-body">
        {% set extension_summary = data.extension_summary | default({}) %}
        {% set extension_items = extension_summary["items"] | default([]) %}

        {% if extension_summary and extension_items %}
            {% set main_extension = extension_items[0] | default({}) %}

            <div class="detail-panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); margin-bottom: 12px;">
                <div class="detail-panel">
                    <h3 class="detail-panel-title">Resumen de extensiones</h3>

                    <table class="detail-table">
                        <tbody>
                            <tr>
                                <th>Extensiones</th>
                                <td>{{ extension_items | length }}</td>
                            </tr>
                            <tr>
                                <th>Items</th>
                                <td>{{ extension_summary.totalItems | default("N/A") }}</td>
                            </tr>
                            <tr>
                                <th>Tamano total</th>
                                <td>{{ extension_summary.totalSizeFormatted | default("N/A") }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="detail-panel">
                    <h3 class="detail-panel-title">Lectura rapida</h3>

                    <table class="detail-table">
                        <tbody>
                            <tr>
                                <th>Principal</th>
                                <td>{{ main_extension.extension | default("N/A") }}</td>
                            </tr>
                            <tr>
                                <th>Cantidad</th>
                                <td>{{ main_extension.count | default("N/A") }}</td>
                            </tr>
                            <tr>
                                <th>Tamano</th>
                                <td>{{ main_extension.sizeFormatted | default("N/A") }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Extension</th>
                            <th>Cantidad</th>
                            <th>Tamano</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in extension_items %}
                            <tr>
                                <td>{{ item.extension | default("N/A") }}</td>
                                <td>{{ item.count | default(0) }}</td>
                                <td>{{ item.sizeFormatted | default("N/A") }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty-message">No hay resumen de extensiones disponible.</p>
        {% endif %}
    </div>
</details>

<details class="section collapsible-section" id="all-items-section">
    <summary class="collapsible-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
        </svg>
        Todos los items
    </summary>

    <div class="collapsible-body">
        {% if data.all_items %}
            <p class="storage-note">Lista completa de items directos encontrados en la ruta analizada.</p>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Categoria</th>
                            <th>Tamano</th>
                            <th>Uso</th>
                            <th>Estado</th>
                            <th>Ruta</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in data.all_items %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td><strong>{{ item.name | default("N/A") }}</strong></td>
                                <td>{{ item.type | default("N/A") }}</td>
                                <td>{{ item.category | default("N/A") }}</td>
                                <td>{{ item.sizeFormatted | default("N/A") }}</td>
                                <td>{{ item.percent | default(0) }}%</td>
                                <td>{{ item.status | default("N/A") }}</td>
                                <td class="storage-path-cell">{{ item.path | default("N/A") }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty-message">No hay items disponibles.</p>
        {% endif %}
    </div>
</details>

{% if data.error_summary and data.error_summary.total %}
    <details class="section collapsible-section" id="storage-errors-section">
        <summary class="collapsible-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M15 9 9 15"></path>
                <path d="M9 9l6 6"></path>
            </svg>
            Errores del escaneo
        </summary>

        <div class="collapsible-body">
            <div class="storage-chip-row">
                <span class="storage-chip critical">Total: {{ data.error_summary.total }}</span>
            </div>

            {% if data.error_summary.categories %}
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Categoria</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for category, count in data.error_summary.categories.items() %}
                                <tr>
                                    <td>{{ category }}</td>
                                    <td>{{ count }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </details>
{% endif %}
